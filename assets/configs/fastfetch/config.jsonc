{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "~/.config/fastfetch/logo.png",
    "type": "auto",
    "width": 28,
    "height": 12,
    "padding": {
      "top": 1,
      "left": 2,
      "right": 3
    }
  },
  "display": {
    "separator": " 󰄾 ",
    "color": {
      "keys": "magenta",
      "title": "blue"
    },
    "key": {
      "width": 12
    }
  },
  "modules": [
    "title",
    {
      "type": "separator",
      "string": "──"
    },
    {
      "type": "os",
      "key": "󰣇 OS",
      "keyColor": "cyan"
    },
    {
      "type": "kernel",
      "key": "󰗚 Kernel",
      "keyColor": "cyan"
    },
    {
      "type": "uptime",
      "key": "󱎫 Uptime",
      "keyColor": "cyan"
    },
    {
      "type": "packages",
      "key": "󰏖 Packages",
      "keyColor": "cyan"
    },
    {
      "type": "separator",
      "string": "──"
    },
    {
      "type": "wm",
      "key": " WM",
      "keyColor": "magenta"
    },
    {
      "type": "theme",
      "key": "󰔎 Theme",
      "keyColor": "magenta"
    },
    {
      "type": "icons",
      "key": "󰀻 Icons",
      "keyColor": "magenta"
    },
    {
      "type": "terminal",
      "key": " Terminal",
      "keyColor": "magenta"
    },
    {
      "type": "shell",
      "key": " Shell",
      "keyColor": "magenta"
    },
    {
      "type": "separator",
      "string": "──"
    },
    {
      "type": "cpu",
      "key": " CPU",
      "keyColor": "yellow"
    },
    {
      "type": "gpu",
      "key": "󰢮 GPU",
      "keyColor": "yellow"
    },
    {
      "type": "memory",
      "key": " Memory",
      "keyColor": "yellow"
    },
    {
      "type": "disk",
      "key": "󰋊 Disk",
      "keyColor": "yellow"
    },
    {
      "type": "separator",
      "string": "──"
    },
    {
      "type": "colors",
      "symbol": "circle"
    }
  ]
}