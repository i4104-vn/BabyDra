[Desktop Entry]
Type=Application
Name=BabyDra Preview
Comment=BabyDra Media and Image Viewer
Exec=babydra-preview %F
Icon=/usr/share/babydra/logo.png
Terminal=false
Categories=Graphics;Viewer;AudioVideo;
MimeType=image/jpeg;image/png;image/webp;image/gif;image/bmp;image/svg+xml;video/mp4;video/matroska;video/webm;
NoDisplay=false
