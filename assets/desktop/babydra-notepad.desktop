[Desktop Entry]
Type=Application
Name=BabyDra Notepad
Comment=Text editor with syntax highlighting
Exec=babydra-notepad %f
Icon=/usr/share/babydra/logo.png
Terminal=false
Categories=Utility;TextEditor;Development;GTK;
MimeType=text/plain;text/*;application/x-shellscript;text/x-shellscript;text/x-zsh;text/x-bash;text/x-sh;text/x-c;text/x-c++;text/x-csrc;text/x-chdr;text/x-c++src;text/x-c++hdr;text/x-rust;text/x-python;text/x-python3;text/javascript;application/javascript;text/typescript;application/typescript;application/json;application/toml;text/x-toml;application/yaml;text/yaml;text/x-yaml;application/x-yaml;text/markdown;text/x-markdown;text/x-ini;text/x-config;application/x-config;text/x-makefile;text/x-cmake;text/x-dockerfile;text/x-diff;text/x-patch;text/x-log;text/x-go;text/x-java;text/x-lua;text/x-ruby;text/x-perl;text/x-sql;text/html;text/css;text/xml;application/xml;text/csv;
NoDisplay=false
