#!/bin/bash
# Ensure local bin is in PATH
export PATH="$HOME/.local/bin:$PATH"

# Update D-Bus activation environment for session services
dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP=labwc || true

# Autostart configuration for labwc with BabyDra shell

# Start Wayland wallpaper daemon
awww-daemon &
sleep 0.5

# Set the default wallpaper
awww img "$HOME/.config/babydra/wallpaper.png" &

# Start BabyDra status panel
mkdir -p "$HOME/.cache/babydra"
~/.local/bin/babydra-panel > "$HOME/.cache/babydra/panel.log" 2>&1 &

# Start dynamic dark/light titlebar theme monitor
$HOME/.config/labwc/theme-monitor.sh &
