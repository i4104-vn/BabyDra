#!/bin/bash
# Autostart configuration for labwc with BabyDra shell
# Auto-generated by Settings

export PATH="$HOME/.local/bin:$PATH"
dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP=labwc || true
babydra-switcher --daemon &
~/.local/bin/babydra-keymap &

fcitx5 -d &
mkdir -p "$HOME/.cache/babydra"
echo 1 > "$HOME/.cache/babydra/current_workspace"
rm -f "$HOME/.cache/babydra/workspace_windows.json"
~/.local/bin/babydra-panel &
~/.local/bin/babydra-desktop &
~/.local/bin/babydra-settings --apply-all-settings &
$HOME/.config/labwc/scripts/bat_saver.sh &


